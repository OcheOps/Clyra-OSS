# ──────────────────────────────────────────────────────────────────────
# Clyra — environment variables
#
# Copy to .env for local dev:   cp .env.example .env
# For production: set these in your platform's secret manager, not .env.
# ──────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────

# Postgres connection string. Any Postgres 14+ works.
POSTGRES_URL=postgres://clyra:clyra@localhost:5432/clyra?sslmode=disable

# Redis is required for rate limiting + MCP daily quotas across replicas.
REDIS_URL=redis://localhost:6379

# 32+ random bytes. Rotate = all sessions invalidated.
# Generate: openssl rand -base64 48
SESSION_SECRET=change-me-to-48-random-bytes

# Comma-separated list of origins the SPA can call from. '*' is rejected
# in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Dev-only knob — allow unauthenticated access to things that would 401
# in production. NEVER set this to development on a public deployment.
ENV=development

# ── BYO AI providers (at least one needed to generate) ────────────────

# Users bring their own keys via Settings → BYO keys. Nothing on the
# server here. (Managed Bedrock is disabled by default in OSS builds —
# re-enable in cmd/server/main.go if you want to run a managed path.)

# ── OAuth (optional) ──────────────────────────────────────────────────

# Google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# GitHub
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback

# Where OAuth redirects the user back to after login.
OAUTH_FRONTEND_URL=http://localhost:3000

# ── Email (optional — needed for invites + password reset) ────────────

RESEND_API_KEY=
RESEND_FROM_EMAIL=admin@example.com
RESEND_APP_URL=http://localhost:3000

# ── Error reporting (optional) ────────────────────────────────────────

SENTRY_DSN=

# ── S3-compatible storage for cloud project backups (optional) ────────

S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Rate limits (sensible defaults; tune if needed) ───────────────────

RATE_LIMIT_AUTH_RPM=30
ABUSE_USER_RATE_PER_MINUTE=20
ABUSE_DAILY_LIMIT=50

# ── Admin ─────────────────────────────────────────────────────────────

# Email of the first admin. Used by scripts/promote-admin.
ADMIN_EMAIL=admin@example.com

# ── Registration ──────────────────────────────────────────────────────

# 'open' (default) or 'invite' (code required to sign up).
REGISTRATION_MODE=open
