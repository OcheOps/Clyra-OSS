{
  "version": "1",
  "cloud": "aws",
  "region": "us-east-1",
  "metadata": {
    "stack_name": "rag_app",
    "description": "RAG application with API Gateway, Lambda, OpenSearch, and S3.",
    "starter_only": true
  },
  "resources": [
    {"id": "api", "kind": "aws_apigatewayv2_api", "props": {"name": "rag-api", "protocol_type": "HTTP"}},
    {"id": "fn", "kind": "aws_lambda_function", "props": {"function_name": "rag-app-handler", "runtime": "python3.12", "handler": "index.handler", "timeout": 30, "memory_size": 512}},
    {"id": "integration", "kind": "aws_apigatewayv2_integration", "props": {"api_id": "api", "integration_type": "AWS_PROXY", "integration_uri": "${aws_lambda_function.fn.invoke_arn}", "payload_format_version": "2.0"}},
    {"id": "route", "kind": "aws_apigatewayv2_route", "props": {"api_id": "api", "route_key": "POST /query", "target": "integrations/${aws_apigatewayv2_integration.integration.id}"}},
    {"id": "invoke_permission", "kind": "aws_lambda_permission", "props": {"function_name": "fn", "principal": "apigateway.amazonaws.com"}},
    {"id": "search", "kind": "aws_opensearch_domain", "props": {"domain_name": "rag-search", "engine_version": "OpenSearch_2.11", "instance_type": "t3.small.search", "instance_count": 1}},
    {"id": "bucket", "kind": "aws_s3_bucket", "props": {"bucket": "rag-app-documents"}},
    {"id": "logs", "kind": "aws_cloudwatch_log_group", "props": {"name": "/aws/lambda/rag-app-handler", "retention_in_days": 14}}
  ],
  "edges": [
    {"from": "api", "to": "fn", "relation": "routes_to"},
    {"from": "fn", "to": "search", "relation": "references"},
    {"from": "fn", "to": "bucket", "relation": "references"}
  ],
  "outputs": [
    {"name": "search_arn", "from": "search", "attr": "arn", "description": "OpenSearch domain ARN."}
  ]
}
