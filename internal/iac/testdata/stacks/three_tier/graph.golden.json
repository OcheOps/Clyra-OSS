{
  "version": "1",
  "cloud": "aws",
  "region": "us-east-1",
  "metadata": {
    "stack_name": "three_tier",
    "description": "Traditional three-tier stack with EC2 application hosts, ALB, and RDS.",
    "starter_only": true
  },
  "parameters": [
    {"name": "db_password", "type": "string", "description": "Initial DB password (rotate after apply)."}
  ],
  "resources": [
    {"id": "vpc", "kind": "aws_vpc", "props": {"cidr_block": "10.2.0.0/16", "enable_dns_hostnames": true}},
    {"id": "subnet_a", "kind": "aws_subnet", "props": {"vpc": "vpc", "cidr_block": "10.2.1.0/24", "availability_zone": "us-east-1a", "map_public_ip_on_launch": true}},
    {"id": "subnet_b", "kind": "aws_subnet", "props": {"vpc": "vpc", "cidr_block": "10.2.2.0/24", "availability_zone": "us-east-1b", "map_public_ip_on_launch": true}},
    {"id": "sg_alb", "kind": "aws_security_group", "props": {"vpc": "vpc", "ingress": [{"from_port": 80, "to_port": 80, "protocol": "tcp", "cidr": "0.0.0.0/0"}]}},
    {"id": "sg_web", "kind": "aws_security_group", "props": {"vpc": "vpc", "ingress_from_sg": [{"sg": "sg_alb", "from_port": 80, "to_port": 80, "protocol": "tcp"}]}},
    {"id": "sg_db", "kind": "aws_security_group", "props": {"vpc": "vpc", "ingress_from_sg": [{"sg": "sg_web", "from_port": 5432, "to_port": 5432, "protocol": "tcp"}]}},
    {"id": "alb", "kind": "aws_alb", "props": {"subnets": ["subnet_a", "subnet_b"], "security_groups": ["sg_alb"]}},
    {"id": "tg", "kind": "aws_target_group", "props": {"vpc": "vpc", "port": 80, "protocol": "HTTP", "target_type": "instance"}},
    {"id": "listener", "kind": "aws_listener", "props": {"load_balancer": "alb", "port": 443, "protocol": "HTTPS", "target_group": "tg"}},
    {"id": "web", "kind": "aws_ec2_instance", "props": {"ami": "ami-1234567890abcdef0", "instance_type": "t3.small", "subnet": "subnet_a", "security_groups": ["sg_web"], "associate_public_ip": true}, "depends_on": ["listener"]},
    {"id": "db_subnets", "kind": "aws_rds_subnet_group", "props": {"subnets": ["subnet_a", "subnet_b"]}},
    {"id": "db", "kind": "aws_rds_instance", "props": {"engine": "postgres", "instance_class": "db.t4g.micro", "allocated_storage": 20, "db_name": "app", "db_subnet_group": "db_subnets", "vpc_security_groups": ["sg_db"], "skip_final_snapshot": true, "storage_encrypted": true}}
  ],
  "edges": [
    {"from": "alb", "to": "web", "relation": "routes_to"},
    {"from": "web", "to": "db", "relation": "references"}
  ],
  "outputs": [
    {"name": "alb_dns", "from": "alb", "attr": "dns_name", "description": "ALB public DNS."},
    {"name": "db_host", "from": "db", "attr": "endpoint", "description": "RDS endpoint."}
  ]
}
