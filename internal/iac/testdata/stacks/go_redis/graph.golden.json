{
  "version": "1",
  "cloud": "aws",
  "region": "us-east-1",
  "metadata": {
    "stack_name": "go_redis",
    "description": "Go API on ECS Fargate behind ALB with ElastiCache Redis.",
    "starter_only": true
  },
  "resources": [
    {"id": "vpc", "kind": "aws_vpc", "props": {"cidr_block": "10.1.0.0/16", "enable_dns_hostnames": true}},
    {"id": "subnet_a", "kind": "aws_subnet", "props": {"vpc": "vpc", "cidr_block": "10.1.1.0/24", "availability_zone": "us-east-1a", "map_public_ip_on_launch": true}},
    {"id": "subnet_b", "kind": "aws_subnet", "props": {"vpc": "vpc", "cidr_block": "10.1.2.0/24", "availability_zone": "us-east-1b", "map_public_ip_on_launch": true}},
    {"id": "sg_alb", "kind": "aws_security_group", "props": {"vpc": "vpc", "ingress": [{"from_port": 80, "to_port": 80, "protocol": "tcp", "cidr": "0.0.0.0/0"}]}},
    {"id": "sg_api", "kind": "aws_security_group", "props": {"vpc": "vpc", "ingress_from_sg": [{"sg": "sg_alb", "from_port": 8080, "to_port": 8080, "protocol": "tcp"}]}},
    {"id": "sg_redis", "kind": "aws_security_group", "props": {"vpc": "vpc", "ingress_from_sg": [{"sg": "sg_api", "from_port": 6379, "to_port": 6379, "protocol": "tcp"}]}},
    {"id": "redis_subnets", "kind": "aws_elasticache_subnet_group", "props": {"subnets": ["subnet_a", "subnet_b"]}},
    {"id": "redis", "kind": "aws_elasticache_cluster", "props": {"engine": "redis", "node_type": "cache.t4g.micro", "num_cache_nodes": 1, "subnet_group": "redis_subnets", "security_groups": ["sg_redis"], "port": 6379}},
    {"id": "ecs", "kind": "aws_ecs_cluster", "props": {}},
    {"id": "task", "kind": "aws_ecs_task_definition", "props": {"family": "go-api", "cpu": "256", "memory": "512", "image": "public.ecr.aws/docker/library/golang:1.22", "container_name": "go-api", "container_port": 8080}},
    {"id": "tg", "kind": "aws_target_group", "props": {"vpc": "vpc", "port": 8080, "protocol": "HTTP", "target_type": "ip"}},
    {"id": "alb", "kind": "aws_alb", "props": {"subnets": ["subnet_a", "subnet_b"], "security_groups": ["sg_alb"]}},
    {"id": "listener", "kind": "aws_listener", "props": {"load_balancer": "alb", "port": 443, "protocol": "HTTPS", "target_group": "tg"}},
    {"id": "api", "kind": "aws_ecs_service", "props": {"cluster": "ecs", "task_definition": "task", "desired_count": 2, "launch_type": "FARGATE", "subnets": ["subnet_a", "subnet_b"], "security_groups": ["sg_api"], "target_group": "tg", "container_name": "go-api", "container_port": 8080, "assign_public_ip": true}, "depends_on": ["listener"]}
  ],
  "edges": [
    {"from": "alb", "to": "api", "relation": "routes_to"},
    {"from": "api", "to": "redis", "relation": "references"}
  ],
  "outputs": [
    {"name": "alb_dns", "from": "alb", "attr": "dns_name", "description": "ALB public DNS."}
  ]
}
