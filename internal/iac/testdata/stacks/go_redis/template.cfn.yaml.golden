AWSTemplateFormatVersion: "2010-09-09"
Description: Go API on ECS Fargate behind ALB with ElastiCache Redis.
Resources:
  Alb:
    Type: AWS::ElasticLoadBalancingV2::LoadBalancer
    Properties:
      Name: alb
      Scheme: internet-facing
      SecurityGroups:
        - !Ref SgAlb
      Subnets:
        - !Ref SubnetA
        - !Ref SubnetB
      Type: application
  Api:
    Type: AWS::ECS::Service
    DependsOn:
      - Listener
    Properties:
      Cluster: !Ref Ecs
      DesiredCount: 2
      LaunchType: FARGATE
      LoadBalancers:
        - ContainerName: go-api
          ContainerPort: 8080
          TargetGroupArn: !Ref Tg
      NetworkConfiguration:
        AwsvpcConfiguration:
          AssignPublicIp: ENABLED
          SecurityGroups:
            - !Ref SgApi
          Subnets:
            - !Ref SubnetA
            - !Ref SubnetB
      ServiceName: api
      TaskDefinition: !Ref Task
  Ecs:
    Type: AWS::ECS::Cluster
    Properties:
      ClusterName: ecs
  Listener:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      Certificates:
        - CertificateArn: arn:aws:acm:us-east-1:123456789012:certificate/replace-me
      DefaultActions:
        - TargetGroupArn: !Ref Tg
          Type: forward
      LoadBalancerArn: !Ref Alb
      Port: 443
      Protocol: HTTPS
  Redis:
    Type: AWS::ElastiCache::CacheCluster
    Properties:
      CacheNodeType: cache.t4g.micro
      CacheSubnetGroupName: !Ref RedisSubnets
      ClusterName: redis
      Engine: redis
      NumCacheNodes: 1
      VpcSecurityGroupIds:
        - !Ref SgRedis
  RedisSubnets:
    Type: AWS::ElastiCache::SubnetGroup
    Properties:
      Description: redis_subnets
      SubnetIds:
        - !Ref SubnetA
        - !Ref SubnetB
  SgAlb:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: sg_alb
      SecurityGroupEgress:
        - CidrIp: 0.0.0.0/0
          IpProtocol: "-1"
      SecurityGroupIngress:
        - CidrIp: 0.0.0.0/0
          FromPort: 80
          IpProtocol: tcp
          ToPort: 80
      VpcId: !Ref Vpc
  SgApi:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: sg_api
      SecurityGroupEgress:
        - CidrIp: 0.0.0.0/0
          IpProtocol: "-1"
      SecurityGroupIngress:
        - FromPort: 8080
          IpProtocol: tcp
          SourceSecurityGroupId: !Ref SgAlb
          ToPort: 8080
      VpcId: !Ref Vpc
  SgRedis:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: sg_redis
      SecurityGroupEgress:
        - CidrIp: 0.0.0.0/0
          IpProtocol: "-1"
      SecurityGroupIngress:
        - FromPort: 6379
          IpProtocol: tcp
          SourceSecurityGroupId: !Ref SgApi
          ToPort: 6379
      VpcId: !Ref Vpc
  SubnetA:
    Type: AWS::EC2::Subnet
    Properties:
      AvailabilityZone:
        Fn::Select:
          - 0
          - Fn::GetAZs: ""
      CidrBlock: 10.1.1.0/24
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: subnet_a
      VpcId: !Ref Vpc
  SubnetB:
    Type: AWS::EC2::Subnet
    Properties:
      AvailabilityZone:
        Fn::Select:
          - 1
          - Fn::GetAZs: ""
      CidrBlock: 10.1.2.0/24
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: subnet_b
      VpcId: !Ref Vpc
  Task:
    Type: AWS::ECS::TaskDefinition
    Properties:
      ContainerDefinitions:
        - Image: public.ecr.aws/docker/library/golang:1.22
          Name: go-api
          PortMappings:
            - ContainerPort: 8080
              Protocol: tcp
      Cpu: "256"
      ExecutionRoleArn: arn:aws:iam::123456789012:role/ecsTaskExecutionRole
      Family: go-api
      Memory: "512"
      NetworkMode: awsvpc
      RequiresCompatibilities:
        - FARGATE
  Tg:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      HealthCheckPath: /
      Name: tg
      Port: 8080
      Protocol: HTTP
      TargetType: ip
      VpcId: !Ref Vpc
  Vpc:
    Type: AWS::EC2::VPC
    Properties:
      CidrBlock: 10.1.0.0/16
      EnableDnsHostnames: true
      Tags:
        - Key: Name
          Value: vpc
Outputs:
  AlbDns:
    Description: ALB public DNS.
    Value: !GetAtt Alb.DNSName
